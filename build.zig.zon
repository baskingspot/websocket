            .hash = "http-0.4.2-bxrZzWO0EAA0ptYai83GbL45InOpXgHVVLrXZ9mUfqvt",
            .lazy = true,
        },
        // The test runner and the bench engine. Lazy: only the root build
        // uses it, and build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.4.0.tar.gz",
            .hash = "testingx-0.4.0-ib95-2JkAwDVM639ma-akYafT4bdewLfpFaAEnLBzQXG",
            .lazy = true,
        },
    },
    .paths = .{
