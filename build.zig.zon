.{
    .name = .websocket,
    .version = "0.1.0",
    .fingerprint = 0x42ce80b95e1d4450,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The HTTP layer the interop example drives. Lazy: only that example
        // imports it, and the library never does.
        .http = .{
            .url = "https://baskingspot.dev/http/v0.1.0.tar.gz",
            .hash = "http-0.1.0-bxrZzad8DABlcBcnRJXiua8ORaj2OZYYZh0GUtxBTTOt",
            .lazy = true,
        },
        // The test runner and the bench engine. Lazy: only the root build
        // uses it, and build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.4.0.tar.gz",
            .hash = "testingx-0.4.0-ib95-2JkAwDVM639ma-akYafT4bdewLfpFaAEnLBzQXG",
            .lazy = true,
        },
        .libxev = .{
            // mattrobenolt fork, zig-0.16 branch: upstream is unmaintained
            // and has no 0.16 port.
            .url = "https://github.com/mattrobenolt/libxev/archive/e0da474516d8ab5cdebb908d875fba2139e2e992.tar.gz",
            .hash = "libxev-0.0.0-86vtc5ehBwDOZaMX_9QpMemn8giO-hXdU4yuJA-9yqcA",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
