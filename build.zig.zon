.{
    .name = .websocket,
    .version = "0.3.0",
    .fingerprint = 0x42ce80b95e1d4450,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // The HTTP layer the interop example drives. Lazy: only that example
        // imports it, and the library never does.
        .http = .{
            .url = "https://baskingspot.dev/http/v0.6.0.tar.gz",
            .hash = "http-0.6.0-bxrZzSkiEgA3QqUpoXMp7qDIyFQQOxM8Kwd-y7BcCT4t",
            .lazy = true,
        },
        // The test runner and the bench engine. Lazy: only the root build
        // uses it, and build.zig returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.5.0.tar.gz",
            .hash = "testingx-0.5.0-ib95-9FWAwAzwy03e-h52udEnWkVzuV-gCFJTp1IQ5rV",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
